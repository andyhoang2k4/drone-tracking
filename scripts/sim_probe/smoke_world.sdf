<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="smoke">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.6 0.75 0.9 1</background></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="ground"><static>true</static><link name="l"><visual name="v">
      <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
      <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
    </visual></link></model>
    <model name="red_cube"><static>true</static><pose>10 0 0.5 0 0 0</pose><link name="l"><visual name="v">
      <geometry><box><size>1 1 1</size></box></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
    </visual></link></model>
    <model name="green_person_sized"><static>true</static><pose>14 2 0.85 0 0 0</pose><link name="l"><visual name="v">
      <geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry>
      <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
    </visual></link></model>
    <model name="blue_car_sized"><static>true</static><pose>18 -3 0.7 0 0 0</pose><link name="l"><visual name="v">
      <geometry><box><size>4.5 1.8 1.4</size></box></geometry>
      <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
    </visual></link></model>
    <model name="probe_cam_model"><static>true</static><pose>0 0 12 0 0.7854 0</pose><link name="link">
      <sensor name="probe_cam" type="camera">
        <always_on>1</always_on><update_rate>5</update_rate><topic>probe_cam</topic>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image><width>1344</width><height>756</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>200</far></clip>
          <save enabled="true"><path>frames_smoke</path></save>
        </camera>
      </sensor>
    </link></model>
  </world>
</sdf>
